# PR #946 fixture: the same deployment, plus a hand-written emergency admin
# allowlist. ADMIN_USERS must grant ADMIN_GROUP even while the external
# authorizer is answering "no" (or is unreachable entirely).
DEBUG_MODE=false
FEATURE_PROXY_SECRET_ENABLED=false
FEATURE_AGENT_PORTAL_ENABLED=false
ADMIN_GROUP=atlas_admins
ADMIN_USERS=alice@example.org
AUTH_STATIC_GROUPS=
AUTH_GROUP_CHECK_API_KEY=validation-key
