# PR #946 fixture: an operator who resolves admin-group membership outside
# Atlas. Only the group NAME is configured -- no member is enumerated anywhere,
# which is the pattern issue #945 asked Atlas to support. The validation script
# starts a real HTTP authorizer on AUTH_GROUP_CHECK_URL_PORT and exports the URL.
DEBUG_MODE=false
FEATURE_PROXY_SECRET_ENABLED=false
FEATURE_AGENT_PORTAL_ENABLED=false
ADMIN_GROUP=atlas_admins
ADMIN_USERS=
AUTH_STATIC_GROUPS=
AUTH_GROUP_CHECK_API_KEY=validation-key
