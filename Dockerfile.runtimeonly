# Runtime-only container image for Atlas UI 3.
# Node.js, pip and the compiler toolchain stay in separate build stages, so
# the final image only contains the Python runtime, a shell, and the
# application.
#
# All stages use Chainguard images for a minimal CVE surface.

FROM cgr.dev/chainguard/node:latest-dev AS frontend-build

# Chainguard node defaults to nonroot; switch to root for build operations.
USER root
WORKDIR /app/frontend

COPY frontend/package*.json ./
ENV NPM_CONFIG_CACHE=/tmp/.npm
RUN npm ci

COPY frontend/ ./
ARG VITE_APP_NAME="ATLAS"
ENV VITE_APP_NAME=${VITE_APP_NAME}
ARG VITE_FEATURE_POWERED_BY_ATLAS="false"
ENV VITE_FEATURE_POWERED_BY_ATLAS=${VITE_FEATURE_POWERED_BY_ATLAS}
ARG VITE_FEATURE_ANIMATED_LOGO="true"
ENV VITE_FEATURE_ANIMATED_LOGO=${VITE_FEATURE_ANIMATED_LOGO}
ARG VITE_FEATURE_RAG_CITATIONS="true"
ENV VITE_FEATURE_RAG_CITATIONS=${VITE_FEATURE_RAG_CITATIONS}
ARG GIT_HASH="unknown"
ARG APP_VERSION="unknown"
ENV GIT_HASH=${GIT_HASH}
ENV APP_VERSION=${APP_VERSION}
RUN npm run build


# Both Python stages install the same Wolfi python-3.X package, so the venv
# built here always matches the final image's Python. Bump them together.
FROM cgr.dev/chainguard/wolfi-base AS python-build

RUN apk add --no-cache python-3.14 python-3.14-dev build-base

WORKDIR /app

# Copy only runtime application files (skip docs/test/scripts).
COPY pyproject.toml README.md ./
COPY atlas/ ./atlas/
COPY prompts/ ./prompts/
COPY --from=frontend-build /app/frontend/dist /app/atlas/static

# Remove Python test package from runtime image.
# Container build COPY semantics cannot reliably exclude nested paths across all builder environments,
# so we copy atlas/ once and prune tests in a separate layer.
RUN rm -rf /app/atlas/tests

# Create runtime/config directories and seed config defaults.
RUN mkdir -p \
        /app/config \
        /app/runtime/logs \
        /app/runtime/feedback \
        /app/runtime/uploads && \
    find /app/atlas/config -maxdepth 1 -type f \( -name '*.json' -o -name '*.yml' -o -name '*.yaml' \) -exec cp {} /app/config/ \; && \
    touch /app/runtime/logs/.gitkeep /app/runtime/feedback/.gitkeep /app/runtime/uploads/.gitkeep

# Install Atlas and dependencies into a dedicated virtual environment.
# The `[mcp-demos]` extra matches the main Dockerfile so bundled MCP demo
# servers (e.g. pptx_generator) referenced by the seeded default mcp.json
# work out of the box. Users who want a truly minimal image can replace the
# seeded config and drop the extra.
RUN python3.14 -m venv /app/.venv
ENV VIRTUAL_ENV=/app/.venv
ENV PATH="/app/.venv/bin:$PATH"
RUN pip install --no-cache-dir --upgrade pip && \
    PYO3_USE_ABI3_FORWARD_COMPATIBILITY=1 \
    pip install --no-cache-dir --ignore-requires-python ".[mcp-demos]"


# Final stage: Python, bash, and busybox (sh, env, and basic commands), so
# hooks and agent-portal commands that are shell scripts or use an
# `#!/usr/bin/env` line keep working. apk is removed afterwards: no package
# manager or compiler ends up in the image.
FROM cgr.dev/chainguard/wolfi-base

RUN apk add --no-cache python-3.14 bash busybox && \
    apk del --no-cache wolfi-base apk-tools

ARG GIT_HASH="unknown"

# --chown sets ownership during the copy. A separate `chown -R` layer would
# store every file under /app a second time.
COPY --from=python-build --chown=nonroot:nonroot /app /app

USER nonroot

EXPOSE 8000

ENV VIRTUAL_ENV=/app/.venv \
    PATH="/app/.venv/bin:$PATH" \
    NODE_ENV=production \
    APP_CONFIG_DIR=/app/config \
    RUNTIME_LOG_DIR=/app/runtime/logs \
    RUNTIME_FEEDBACK_DIR=/app/runtime/feedback \
    GIT_HASH=${GIT_HASH} \
    GIT_COMMIT=${GIT_HASH} \
    ATLAS_HOST=0.0.0.0 \
    PORT=8000

WORKDIR /app/atlas

CMD ["/app/.venv/bin/python", "main.py"]
