# Non-secret Atlas settings shared by every replica. Secrets (and the URLs
# that embed them) come from the `atlas-secrets` Secret; see
# api-deployment.yaml. Overlays merge their own values on top.

# Production mode: no debug fallbacks, header auth behind a trusted proxy that
# must present PROXY_SECRET as X-Proxy-Secret.
DEBUG_MODE=false
ATLAS_HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
FEATURE_SUPPRESS_LITELLM_LOGGING=true
FEATURE_PROXY_SECRET_ENABLED=true
AUTH_USER_HEADER=X-User-Email

# Shared state (AGENTS.md "Horizontal Scaling"): live sessions in Redis,
# durable state in PostgreSQL, files in S3. Nothing here may be per-replica.
SESSION_REPOSITORY_TYPE=redis
FEATURE_CHAT_HISTORY_ENABLED=true
USE_MOCK_S3=false
S3_BUCKET_NAME=atlas-files
S3_USE_SSL=false
S3_REGION=us-east-1

# Connection budgets, per replica (one uvicorn worker each):
#   Redis:      REDIS_MAX_CONNECTIONS                                   = 20
#   PostgreSQL: CHAT_HISTORY_DB_POOL_SIZE + CHAT_HISTORY_DB_MAX_OVERFLOW = 10
# plus one short-lived connection per pod start for the migration init
# container. Multiply by replicas (and maxSurge during a rollout) and keep the
# totals below Redis maxclients and PostgreSQL max_connections.
REDIS_MAX_CONNECTIONS=20
REDIS_POOL_TIMEOUT=5
CHAT_HISTORY_DB_POOL_SIZE=5
CHAT_HISTORY_DB_MAX_OVERFLOW=5
CHAT_HISTORY_DB_POOL_TIMEOUT=10
CHAT_HISTORY_DB_POOL_PRE_PING=true
CHAT_HISTORY_DB_CONNECT_TIMEOUT=10

# Per-replica scratch space (emptyDir). MCP per-user tokens live here and are
# therefore NOT shared between replicas; see the limits section of
# docs/admin/kubernetes-staging.md.
MCP_TOKEN_STORAGE_DIR=/data/tokens
APP_LOG_DIR=/app/logs

# Same keepalive the browser relies on to notice a dead socket and reconnect.
WEBSOCKET_KEEPALIVE_INTERVAL_SECONDS=30

# Shared workspaces exercise PostgreSQL across replicas in validation.
FEATURE_WORKSPACES_ENABLED=true

# Libraries that write to $HOME must not depend on the image's UID: OpenShift
# runs the container under an arbitrary UID with no writable home.
HOME=/tmp
