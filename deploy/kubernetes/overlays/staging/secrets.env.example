# Keys the staging overlay's `atlas-secrets` Secret must carry. Do not copy
# these placeholder values: run `deploy/kubernetes/staging.sh init-secrets`,
# which writes overlays/staging/secrets.env with fresh random values.
# Passwords must stay URL-safe (they are embedded in the URLs below).
POSTGRES_PASSWORD=replace-me
REDIS_PASSWORD=replace-me
CHAT_HISTORY_DB_URL=postgresql://atlas:replace-me@atlas-postgres:5432/atlas_chat_history
REDIS_URL=redis://:replace-me@atlas-redis:6379/0
S3_ENDPOINT=http://atlas-minio:9000
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
PROXY_SECRET=replace-me
MCP_TOKEN_ENCRYPTION_KEY=replace-me
CAPABILITY_TOKEN_SECRET=replace-me
